# Template for the GITIGNORED `.env` at the repo root (NOT this file -- copy it, then edit the copy):
#
#   Copy-Item backtest/env.example .env        # PowerShell, from the repo root
#   notepad .env                               # type the two values in yourself
#
# Use your Alpaca PAPER account's key id and secret. Never paste them into chat, a commit or a
# log. `.env` is listed in .gitignore; the data layer refuses to read it unless git confirms that.
ALPACA_API_KEY=
ALPACA_API_SECRET=
